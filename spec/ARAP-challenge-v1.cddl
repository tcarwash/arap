; ARAP challenge-response profile, wire version 1.
; The complete encoded COSE response MUST NOT exceed 65,536 bytes.
; All maps use RFC 8949 core deterministic encoding. The response is a tagged
; COSE_Sign1 using the same protected headers and Ed25519 (-19) as the content
; profile. The request is canonical CBOR whose exact bytes are hashed.

challenge-request = {
  1: "ARAP",
  2: 1,
  3: "challenge-request",
  4: callsign,                  ; requester
  5: callsign,                  ; responder
  6: bstr .size 16,             ; CSPRNG nonce
  7: uint,                      ; issued_at, Unix seconds
  8: uint,                      ; expires_at, Unix seconds
  9: tstr .size (1..64),        ; requested authentication purpose
  ? 10: bstr .size (1..128),    ; opaque application session binding
}

challenge-response-payload = {
  1: "ARAP",
  2: 1,
  3: "challenge-response",
  4: callsign,                  ; responder
  5: uint,                      ; response creation time
  6: uint,                      ; MUST equal request expiry
  7: challenge-response-subject,
}

challenge-response-subject = {
  1: bstr .size 32,             ; SHA-256 of exact canonical request bytes
  2: bstr .size 16,             ; request nonce
  3: callsign,                  ; requester
  4: callsign,                  ; responder
  5: tstr .size (1..64),        ; requested authentication purpose
  6: uint,                      ; request expires_at
  ? 7: bstr .size (1..128),     ; exact session binding, when present in request
}

callsign = tstr .size (3..20)

; Additional profile rules:
; - Requester and responder MUST differ and be normalized callsigns.
; - Lifetime MUST be positive and no more than 600 seconds.
; - Responses MUST be checked against the exact locally recorded request.
; - Maximum accepted future clock skew is 30 seconds.
; - Verify the response signature before applying challenge freshness policy so
;   a valid expired response and corrupted proof bytes remain distinguishable.
; - Verification checks local trust, parties, request hash, nonce, purpose,
;   expiry and session binding before atomically consuming the request.
; - A SQLite conditional UPDATE is the reference persistent consume transition.
;   Failed, unknown, expired or consumed requests MUST NOT authenticate.
